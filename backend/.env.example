# MongoDB Connection
# Untuk lokal: mongodb://localhost:27017
# Untuk Atlas: mongodb+srv://username:password@cluster.mongodb.net/
MONGO_URL=mongodb://localhost:27017

# Nama database
DB_NAME=ssb_academy

# JWT Secret Key (ganti dengan string acak yang panjang untuk production)
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ganti-dengan-secret-key-anda-yang-aman
